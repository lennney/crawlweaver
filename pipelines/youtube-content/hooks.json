{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": ".hooks/on-session-start.sh",
            "timeout": 10,
            "statusMessage": "Loading workspace context (AGENTS.md + HANDOVER.md)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": ".hooks/on-pretooluse.sh",
            "timeout": 5,
            "statusMessage": "Checking for dangerous file operations"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".hooks/on-posttooluse.sh",
            "timeout": 5,
            "statusMessage": "Recording file changes"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": ".hooks/on-precompact.sh",
            "timeout": 5,
            "statusMessage": "Saving session state before compaction"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".hooks/on-session-end.sh",
            "timeout": 10,
            "statusMessage": "Updating HANDOVER.md with session summary"
          }
        ]
      }
    ]
  }
}
