# CrawlWeaver — Environment Variables
# Copy to systemd service directly (EnvironmentFile 不靠谱)

# LLM Provider (OpenCode Go / DeepSeek-compatible)
DEEPSEEK_API_KEY=sk-xxx
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4-flash

# 飞书 Bot (2026-06-28 新增)
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_VERIFICATION_TOKEN=xxx          # 事件与回调 → 验证 Token
# FEISHU_ENCRYPT_KEY=xxx               # 加密回调时才需要

# Ollama (fallback, local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
